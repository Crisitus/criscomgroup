# ---------------------------------------------------------------------------
# Criscom Group — Backend ENV template.
#
# Copia como `.env` para desarrollo local. En producción, estas variables las
# inyecta docker-compose desde el .env raíz (NO necesitas llenar esto allá).
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# Database (MySQL 8.0)
DB_HOST=db
DB_PORT=3306
DB_SYNC_ON_START=auto
DB_NAME=erp_computacion
DB_USER=erpcomp
DB_PASSWORD=
DB_DIALECT=mysql

# Autenticación — generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# OAuth Web Client ID de Google. No es secreto, pero debe coincidir con Ecommerce.
GOOGLE_CLIENT_ID=

# Usuario maestro. La contraseña real solo debe ir en el .env privado.
MASTER_ADMIN_NAME=Administrador
MASTER_ADMIN_EMAIL=admin@tudominio.com
MASTER_ADMIN_PASSWORD=

# Integraciones externas
RENIEC_API_KEY=

# Pagos Culqi (llaves de prueba durante el desarrollo)
PAYMENTS_MODE=sandbox
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_API_URL=https://api.culqi.com/v2

# Facturación directa SUNAT SEE del contribuyente
SUNAT_MODE=sandbox
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_PRIVATE_KEY_PATH=
SUNAT_CERTIFICATE_PATH=
SUNAT_BILL_SERVICE_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# Integración privada OpenClaw WhatsApp -> expedientes de Servicio Técnico.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENCLAW_SERVICE_WEBHOOK_SECRET=
# JSON teléfono internacional -> id_user del técnico asignable. Ej.: {"51999999999":6}
OPENCLAW_SERVICE_TECHNICIANS={}
# Configuración independiente por emisor. RUC10 puede usar el fallback anterior.
SUNAT_RUC10_SOL_USER=
SUNAT_RUC10_SOL_PASSWORD=
SUNAT_RUC10_PRIVATE_KEY_PATH=
SUNAT_RUC10_CERTIFICATE_PATH=
SUNAT_RUC10_PFX_PATH=
SUNAT_RUC10_PFX_PASSWORD=
SUNAT_RUC10_PFX_PASSWORD_B64=
# Mantener RUC20 sin configurar y deshabilitado hasta su validación.
SUNAT_RUC20_SOL_USER=
SUNAT_RUC20_SOL_PASSWORD=
SUNAT_RUC20_PRIVATE_KEY_PATH=
SUNAT_RUC20_CERTIFICATE_PATH=
SUNAT_RUC20_PFX_PATH=
SUNAT_RUC20_PFX_PASSWORD=
SUNAT_RUC20_PFX_PASSWORD_B64=

# Feature flags (encienden/apagan módulos del API)
FEATURE_ECOMMERCE=false
FEATURE_MARKETING=false
FEATURE_LIBRO_RECLAMACIONES=false

# URL pública canónica del API (ej. https://api.criscomgroup.com.pe)
PUBLIC_BASE_URL=

# Orígenes CORS permitidos (coma-separados). REQUERIDO en producción.
# Ej: https://criscomgroup.com.pe,https://app.criscomgroup.com.pe
FRONTEND_ORIGIN=

# Correo de la comunidad (SMTP estándar)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CRISCOM <comunidad@criscomgroup.com.pe>"

# Seguridad HTTP (valores seguros por defecto; ajustar solo con mediciones)
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=256kb
API_RATE_WINDOW_MS=60000
API_RATE_MAX=300
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=10
PUBLIC_FORM_RATE_WINDOW_MS=900000
PUBLIC_FORM_RATE_MAX=8
