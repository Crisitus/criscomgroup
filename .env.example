# ---------------------------------------------------------------------------
# Criscom Group — Variables de entorno para docker-compose.yml (PRODUCCIÓN).
#
# Copia este archivo como `.env` en el VPS y reemplaza los valores:
#   cp .env.example .env
#   nano .env
#
# Nunca commitees el `.env` real — ya está en .gitignore.
#
# Para generar secretos fuertes:
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 32   # MYSQL passwords
# ---------------------------------------------------------------------------

# === Let's Encrypt / Traefik ===
# Email para notificaciones de expiración de certificados.
LETSENCRYPT_EMAIL=admin@tudominio.com

# === MySQL ===
# Passwords: GENERAR CON `openssl rand -base64 32` y reemplazar.
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE_ROOT
MYSQL_DATABASE=erp_computacion
MYSQL_USER=erpcomp
MYSQL_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE_APP

# === Backend (JWT + APIs externas) ===
# GENERAR CON `openssl rand -base64 48` y reemplazar.
JWT_SECRET=REEMPLAZAR_CON_SECRET_ALEATORIO_MINIMO_32_CHARS
JWT_EXPIRES_IN=8h
# Clave independiente para cifrar credenciales de pasarelas. No reutilizar JWT_SECRET.
PAYMENT_CREDENTIALS_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_MINIMO_32_CHARS

# === Usuario maestro del ERP ===
MASTER_ADMIN_NAME=Administrador
MASTER_ADMIN_EMAIL=admin@tudominio.com
MASTER_ADMIN_PASSWORD=REEMPLAZAR_EN_EL_ENV_PRIVADO

# Key de API RENIEC para validación de DNI (opcional, puede quedar vacío).
RENIEC_API_KEY=

# === Culqi + SUNAT (usar sandbox/test hasta el pase a producción) ===
PAYMENTS_MODE=sandbox
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
SUNAT_MODE=sandbox
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_PRIVATE_KEY_PATH=/run/secrets/sunat_private_key.pem
SUNAT_CERTIFICATE_PATH=/run/secrets/sunat_certificate.pem
SUNAT_RUC10_SOL_USER=
SUNAT_RUC10_SOL_PASSWORD=
SUNAT_RUC10_PRIVATE_KEY_PATH=/run/secrets/sunat_ruc10_private_key.pem
SUNAT_RUC10_CERTIFICATE_PATH=/run/secrets/sunat_ruc10_certificate.pem
# Segundo emisor reservado: no habilitar hasta completar pruebas SUNAT.
SUNAT_RUC20_SOL_USER=
SUNAT_RUC20_SOL_PASSWORD=
SUNAT_RUC20_PRIVATE_KEY_PATH=/run/secrets/sunat_ruc20_private_key.pem
SUNAT_RUC20_CERTIFICATE_PATH=/run/secrets/sunat_ruc20_certificate.pem

# === Feature flags (backend + frontend) ===
FEATURE_ECOMMERCE=true
FEATURE_MARKETING=false
FEATURE_LIBRO_RECLAMACIONES=false

# === Frontend extras ===
# URL del servicio externo de facturación electrónica, si aplica.
# Si no tienes uno, déjalo apuntando al mismo dominio API.
VITE_FACTURADOR_API_URL=https://criscomgroup.com.pe/api
CANONICAL_SITE_URL=https://criscomgroup.com.pe
