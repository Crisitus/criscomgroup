# ---------------------------------------------------------------------------
# Criscom Group — .gitignore raíz (monorepo: Backend + Frontend + Ecommerce).
# ---------------------------------------------------------------------------

# === OS / IDE ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.vs/

# === Secretos / Entornos locales ===
.env
.env.local
.env.*.local
# Backups/dumps de env (p.ej. .env.local.bak-prod) — NUNCA commitear secretos reales.
.env*.bak*
*.bak-prod
!.env.example
!.env.test
!Backend/.env.example
!Backend/.env.test
!Frontend/.env.example
!Ecommerce/.env.example

# === Dependencias (Node) ===
node_modules/
.pnp/
.pnp.js

# === Build artifacts ===
# Vite / React
Frontend/dist/
Frontend/.vite/

# Next.js
Ecommerce/.next/
Ecommerce/out/
Ecommerce/.turbo/
Ecommerce/tsconfig.tsbuildinfo

# Backend (si algún día se transpila)
Backend/dist/
Backend/build/

# === Testing ===
coverage/
*.lcov
.nyc_output/
junit.xml
Ecommerce/playwright-report/
Ecommerce/test-results/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# === Uploads / runtime ===
# Archivos subidos por usuarios en dev — en prod son Docker volumes.
Backend/src/uploads/*
!Backend/src/uploads/.gitkeep

# === Docker local ===
# Archivos generados por docker, overrides locales, etc.
docker-compose.override.yml
.docker/

# === Letsencrypt / Traefik (cuando se despliegue localmente) ===
letsencrypt/
acme.json

# === Misc ===
.cache/
.parcel-cache/
.eslintcache
.tsbuildinfo

# --- Artefactos runtime/build no versionables (añadido CRiSTEM 2026-08-13) ---
.runtime/
Ecommerce/.next-*/
*.tar.gz

# === Publicación GitHub (2026-10-20) ===
# Instaladores y artefactos pesados ajenos al código
*.dmg
# odd/: solo se versiona la documentación de tareas ODD
odd/*
!odd/tasks/
