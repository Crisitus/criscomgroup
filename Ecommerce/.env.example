# ---------------------------------------------------------------------------
# Criscom Group — Ecommerce (Next.js) ENV template.
#
# Copia como `.env.local` para desarrollo (Next.js carga .env.local con
# mayor prioridad que .env). En producción, build-args del docker-compose.
#
# Las variables NEXT_PUBLIC_* se inlinean al bundle del cliente —
# NUNCA pongas secretos ahí, todo lo que prefijas con NEXT_PUBLIC_ es
# visible en el navegador.
# ---------------------------------------------------------------------------

# URL base del Backend ERP (sin trailing slash).
# Dev: http://localhost:3100
# Prod: https://api.criscomgroup.com.pe
NEXT_PUBLIC_API_URL=http://localhost:3100

# URL pública canónica del sitio (para metadataBase, OpenGraph, SEO).
# Dev: http://localhost:3000
# Prod: https://criscomgroup.com.pe
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth 2.0 Web Client ID de Google (valor publico; nunca usar Client Secret aquí)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Llave pública Culqi (nunca colocar la llave secreta en Next.js)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
