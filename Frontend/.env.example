# ---------------------------------------------------------------------------
# Criscom Group — ERP Frontend ENV template.
#
# Las VITE_* se inlinean al bundle durante el build (no son runtime env).
# En producción las pasa docker-compose como build-args.
# ---------------------------------------------------------------------------

# URL base del Backend API
VITE_API_URL=http://localhost:3100/api

# URL del servicio de facturación electrónica (si aplica)
VITE_FACTURADOR_API_URL=http://localhost:8001/api

# Feature flags
VITE_FEATURE_ECOMMERCE=false
VITE_FEATURE_MARKETING=true
VITE_FEATURE_LIBRO_RECLAMACIONES=false
